###> symfony/framework-bundle ###
APP_ENV=dev
# Gere um valor com: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> docker/mysql ###
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=tjjud_db
MYSQL_USER=tjjud_user
MYSQL_PASSWORD=
###< docker/mysql ###

###> doctrine/doctrine-bundle ###
# O Dotenv resolve as variáveis do MySQL definidas acima
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@db:3306/${MYSQL_DATABASE}?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###
