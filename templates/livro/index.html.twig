{% extends 'base.html.twig' %}

{% block title %}{{ 'Livros' }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Livros</h1>
        <a href="{{ path('app_livro_new') }}" class="btn btn-dark">
            <i class="bi bi-plus-lg me-1"></i>{{ 'Novo livro' }}
        </a>
    </div>

    <form method="get" action="{{ path('app_livro_index') }}" class="input-group mb-3 shadow-sm">
        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
        <input class="form-control" name="q" placeholder="Buscar por título..." value="{{ filtro }}">
    </form>

    <div class="vstack gap-3 mb-4">
        {% for livro in livros %}
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex justify-content-between gap-3">
                    <div>
                        <h5 class="mb-1">
                            <a href="{{ path('app_livro_show', {'codl': livro.codl}) }}" class="text-decoration-none text-reset">
                                {{ livro.titulo }}
                            </a>
                        </h5>
                        <div class="small text-muted">
                            {{ livro.editora }} · {{ livro.edicao }}ª ed. · {{ livro.anoPublicacao }}
                        </div>
                        <div class="small mt-1">
                            <i class="bi bi-person me-1"></i>
                            {{ livro.autores|map(a => a.nome)|join(', ') }}
                        </div>
                        <div class="mt-2">
                            {% for assunto in livro.assuntos %}
                                <span class="badge text-bg-success me-1">{{ assunto.descricao }}</span>
                            {% endfor %}
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="fs-5 fw-bold text-success text-nowrap">
                            R$&nbsp;{{ livro.valor|number_format(2, ',', '.') }}
                        </div>
                        <div class="mt-2 text-nowrap">
                            <a href="{{ path('app_livro_edit', {'codl': livro.codl}) }}"
                               class="btn btn-sm btn-outline-primary me-1" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="post" action="{{ path('app_livro_delete', {'codl': livro.codl}) }}"
                                  class="d-inline" onsubmit="return confirm('Remover este livro?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ livro.codl) }}">
                                <button class="btn btn-sm btn-outline-danger" title="Excluir">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="alert alert-light border text-center">
                {{ 'Nenhum livro encontrado.' }}
            </div>
        {% endfor %}
    </div>
{% endblock %}
