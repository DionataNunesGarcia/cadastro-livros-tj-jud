{% extends 'base.html.twig' %}

{% block title %}Livro{% endblock %}

{% block body %}
    <h1>Livro</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Codl</th>
                <td>{{ livro.codl }}</td>
            </tr>
            <tr>
                <th>Titulo</th>
                <td>{{ livro.titulo }}</td>
            </tr>
            <tr>
                <th>Editora</th>
                <td>{{ livro.editora }}</td>
            </tr>
            <tr>
                <th>Edicao</th>
                <td>{{ livro.edicao }}</td>
            </tr>
            <tr>
                <th>AnoPublicacao</th>
                <td>{{ livro.anoPublicacao }}</td>
            </tr>
            <tr>
                <th>Valor</th>
                <td>{{ livro.valor }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_livro_index') }}">back to list</a>

    <a href="{{ path('app_livro_edit', {'codl': livro.codl}) }}">edit</a>

    {{ include('livro/_delete_form.html.twig') }}
{% endblock %}
