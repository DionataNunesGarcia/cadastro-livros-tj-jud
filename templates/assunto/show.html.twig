{% extends 'base.html.twig' %}

{% block title %}{{ 'Assunto' }}{% endblock %}

{% block body %}
    <div class="py-4 mt-10 row justify-content-center">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-success fw-semibold text-white">{{ 'Assunto' }}</div>
                <div class="card-body">
                    <div>
                        <div class="d-flex gap-4">
                            <strong>{{ 'Código' }}:</strong>
                            <span>{{ assunto.codAs }}</span>
                        </div>
                        <div class="d-flex gap-4">
                            <strong>{{ 'Descrição' }}:</strong>
                            <span>{{ assunto.descricao }}</span>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <a href="{{ path('app_assunto_index') }}" class="btn btn-sm btn-outline-secondary">{{ 'Voltar' }}</a>
                    {% include 'assunto/_delete_form.html.twig' %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
