{% extends 'base.html.twig' %}

{% block title %}{{ 'Assuntos' }}{% endblock %}

{% block body %}
    <div class="py-4 mt-10">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-success text-white d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span class="fw-semibold">
                    <i class="bi bi-file-earmark-bar-graph me-2"></i>{{ 'Lista de Assuntos' }}
                </span>
                <a href="{{ path('app_assunto_new') }}" class="btn btn-sm btn-light">
                    <i class="bi bi-plus-lg me-1"></i>{{ 'Novo assunto' }}
                </a>
            </div>
            <div class="card-body row g-2 align-items-end mb-4">
                <form method="get" action="{{ path('app_assunto_index') }}" class="col-sm-6 col-md-4 mb-3 col-auto d-flex gap-2">
                    <input class="form-control" name="q" placeholder="Buscar por assunto..." value="{{ filtro }}">
                    <button class="btn btn-success d-flex">
                        <i class="bi bi-funnel me-1"></i>{{ 'Filtrar' }}
                    </button>
                </form>
                <div class="vstack gap-3 mb-4">
                    {% for assunto in assuntos %}
                        <div class="card border-0 shadow-sm">
                            <div class="card-body d-flex justify-content-between gap-3">
                                <div>
                                    <h6 class="mb-1">
                                        <a href="{{ path('app_assunto_show', {'codAs': assunto.codAs}) }}" class="text-decoration-none text-reset">
                                            {{ assunto.descricao }}
                                        </a>
                                    </h6>
                                </div>
                                <div class="text-end">
                                    <div class="mt-2 text-nowrap">
                                        <a href="{{ path('app_assunto_show', {'codAs': assunto.codAs}) }}"
                                           class="btn btn-sm btn-outline-primary me-1" title="{{ 'Mostrar' }}">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="{{ path('app_assunto_edit', {'codAs': assunto.codAs}) }}"
                                           class="btn btn-sm btn-outline-primary me-1" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        {% include 'assunto/_delete_form.html.twig' %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="alert alert-light border text-center">
                            {{ 'Nenhum assunto encontrado.' }}
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
