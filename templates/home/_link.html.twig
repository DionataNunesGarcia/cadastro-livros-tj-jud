<a href="{{ link.rota }}" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
    <span class="d-inline-flex align-items-center justify-content-center bg-dark text-light rounded-2 icon-square">
        <i class="bi {{ link.icone }}"></i>
    </span>
    <span class="flex-grow-1">
        <strong class="d-block">{{ link.titulo }}</strong>
        <small class="text-muted">{{ link.descricao }}</small>
    </span>
    <i class="bi bi-chevron-right text-muted"></i>
</a>
