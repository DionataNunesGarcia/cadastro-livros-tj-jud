{% extends 'base.html.twig' %}

{% block title %}{{ 'Autores' }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">{{ 'Autores' }}</h1>
        <a href="{{ path('app_autor_new') }}" class="btn btn-dark">
            <i class="bi bi-plus-lg me-1"></i>{{ 'Novo autor' }}
        </a>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
            <tr>
                <th>{{ 'Cód.' }}</th>
                <th>{{ 'Nome' }}</th>
                <th class="text-end">{{ 'Ações' }}</th>
            </tr>
            </thead>
            <tbody>
            {% for autor in autores %}
                <tr>
                    <td class="text-muted">{{ autor.codAu }}</td>
                    <td>
                        <a href="{{ path('app_autor_show', {'codAu': autor.codAu}) }}" class="text-decoration-none">
                            {{ autor.nome }}
                        </a>
                    </td>
                    <td class="text-end text-nowrap">
                        <a href="{{ path('app_autor_edit', {'codAu': autor.codAu}) }}"
                           class="btn btn-sm btn-outline-primary me-1" title="{{ 'Editar' }}">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="post" action="{{ path('app_autor_delete', {'codAu': autor.codAu}) }}"
                              class="d-inline" onsubmit="return confirm('{{ 'Remover este autor?' }}');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ autor.codAu) }}">
                            <button class="btn btn-sm btn-outline-danger" title="{{ 'Excluir' }}">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3" class="text-center text-muted py-4">{{ 'Nenhum autor cadastrado.' }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
