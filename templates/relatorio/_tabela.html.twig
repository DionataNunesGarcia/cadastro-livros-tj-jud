{% for autor, livros in porAutor %}
    {% set total = livros|reduce((carry, livro) => carry + livro.valor, 0) %}

    <div class="autor-bloco">
        <h2 class="autor-titulo">
            {{ autor }} <span class="autor-contagem">({{ livros|length }})</span>
        </h2>

        <table class="tabela">
            <thead>
            <tr>
                <th>{{ 'Título' }}</th>
                <th>{{ 'Editora' }}</th>
                <th>{{ 'Ed.' }}</th>
                <th>{{ 'Ano' }}</th>
                <th>{{ 'Assuntos' }}</th>
                <th class="valor">{{ 'Valor' }}</th>
            </tr>
            </thead>
            <tbody>
            {% for livro in livros %}
                <tr class="{{ loop.index is even ? 'par' : 'impar' }}">
                    <td>{{ livro.titulo }}</td>
                    <td>{{ livro.editora }}</td>
                    <td>{{ livro.edicao }}ª</td>
                    <td>{{ livro.ano_publicacao }}</td>
                    <td>{{ livro.assuntos ?: '—' }}</td>
                    <td class="valor">{{ 'R$' }} {{ livro.valor|number_format(2, ',', '.') }}</td>
                </tr>
            {% endfor %}
            </tbody>
            <tfoot>
            <tr>
                <td colspan="5">
                    {{ livros|length }} {{ livros|length == 1 ? 'livro' : 'livros' }}
                </td>
                <td class="valor">{{ 'R$' }} {{ total|number_format(2, ',', '.') }}</td>
            </tr>
            </tfoot>
        </table>
    </div>
{% else %}
    <p>{{ 'Nenhum livro cadastrado.' }}</p>
{% endfor %}
