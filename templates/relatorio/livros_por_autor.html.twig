{% extends 'base.html.twig' %}

{% block title %}{{ 'Relatório — Livros por Autor' }}{% endblock %}

{% block body %}
    <h1 class="h3 mb-0">{{ 'Relatório' }}</h1>
    <div class="py-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-success text-white d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span class="fw-semibold">
                    <i class="bi bi-file-earmark-bar-graph me-2"></i>{{ 'Livros por Autor' }}
                </span>
                <a href="{{ path('app_relatorio_livros_por_autor_pdf', {autor: filtroAutor}) }}"
                   class="btn btn-sm btn-light" target="_blank">
                    <i class="bi bi-file-earmark-pdf me-1"></i>{{ 'Gerar PDF' }}
                </a>
            </div>

            <div class="card-body">
                <form method="get" action="{{ path('app_relatorio_livros_por_autor') }}" class="row g-2 align-items-end mb-4">
                    <div class="col-sm-6 col-md-4">
                        <input type="text" id="autor" name="autor" class="form-control"
                               value="{{ filtroAutor }}" placeholder="{{ 'Buscar por autor...' }}">
                    </div>
                    <div class="col-auto d-flex gap-2">
                        <button class="btn btn-success">
                            <i class="bi bi-funnel me-1"></i>{{ 'Filtrar' }}
                        </button>
                        {% if filtroAutor %}
                            <a href="{{ path('app_relatorio_livros_por_autor') }}"
                               class="btn btn-outline-secondary">{{ 'Limpar' }}</a>
                        {% endif %}
                    </div>
                </form>

                <p class="small text-muted">
                    {{ 'Fonte: view' }} <code>vw_livros_por_autor</code> ·
                    {{ 'Gerado em' }} {{ "now"|date('d/m/Y, H:i:s') }}
                </p>

                {% for autor, livros in porAutor %}
                    {% set total = livros|reduce((carry, livro) => carry + livro.valor, 0) %}

                    <div class="mb-4">
                        <h6 class="border-bottom border-success border-2 pb-1 fw-bold text-success">
                            {{ autor }}
                            <span class="badge text-bg-success-subtle text-success-emphasis ms-1">
                                {{ livros|length }}
                            </span>
                        </h6>

                        <div class="table-responsive">
                            <table class="table table-sm table-striped align-middle mb-1">
                                <thead class="table-light">
                                <tr>
                                    <th>{{ 'Título' }}</th>
                                    <th>{{ 'Editora' }}</th>
                                    <th>{{ 'Ed.' }}</th>
                                    <th>{{ 'Ano' }}</th>
                                    <th>{{ 'Assuntos' }}</th>
                                    <th class="text-end">{{ 'Valor' }}</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for livro in livros %}
                                    <tr>
                                        <td>{{ livro.titulo }}</td>
                                        <td>{{ livro.editora }}</td>
                                        <td>{{ livro.edicao }}ª</td>
                                        <td>{{ livro.ano_publicacao }}</td>
                                        <td>{{ livro.assuntos ?: '—' }}</td>
                                        <td class="text-end text-success fw-semibold">
                                            R$&nbsp;{{ livro.valor|number_format(2, ',', '.') }}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                                <tfoot>
                                <tr class="fw-semibold table-light">
                                    <td colspan="5">
                                        {{ livros|length }} {{ livros|length == 1 ? 'livro' : 'livros' }}
                                    </td>
                                    <td class="text-end">
                                        R$&nbsp;{{ total|number_format(2, ',', '.') }}
                                    </td>
                                </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                {% else %}
                    <div class="alert alert-light border text-center">{{ 'Nenhum livro encontrado.' }}</div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}
